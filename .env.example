APP_NAME=CIDB Chatbot
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_DISABLE_HASHING=true
APP_ENCRYPTION_KEY=change-me-to-a-long-random-secret

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cidb_chatbot
DB_USERNAME=cidb_user
DB_PASSWORD=
DB_TIMEOUT=5

STORAGE_PATH=C:/CIDB-RUNTIME/storage
LOG_PATH=C:/CIDB-RUNTIME/logs
UPLOAD_STORAGE_DRIVER=local
UPLOAD_MAX_FILE_SIZE_MB=10
SIGNATURE_MAX_FILE_SIZE_MB=5

CIMS_ENABLED=false
CIMS_BASE_URL=https://example.invalid
CIMS_VERIFY_ENDPOINT=/api/v1/verify
CIMS_TIMEOUT_MS=15000
CIMS_MOCK_MODE=random
CIMS_MOCK_OUTCOME=deleted
CIMS_API_KEY=
CIMS_CLIENT_ID=
CIMS_CLIENT_SECRET=
